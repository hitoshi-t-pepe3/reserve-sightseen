# Backend Environment Variables
# Copy to backend/.env for local development

# Rakuten Travel API
RAKUTEN_APPLICATION_ID=
RAKUTEN_AFFILIATE_ID=
RAKUTEN_ACCESS_KEY=

# Jalan Web Service
JALAN_AFFILIATE_ID=

# Google Places API
GOOGLE_PLACES_API_KEY=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Frontend URL for CORS (comma-separated)
# NEXT_PUBLIC_API_BASE will also affect this
CORS_ORIGINS=http://localhost:3000,https://faction-scavenger-late.ngrok-free.dev

# App
APP_NAME=ReserveSightseen
DEBUG=false