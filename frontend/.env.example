# Frontend Environment Variables
# Copy to frontend/.env.local for local development

# Backend API URL (uses ngrok tunnel in production)
NEXT_PUBLIC_API_BASE=https://faction-scavenger-late.ngrok-free.dev

# For local development without ngrok:
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Google Maps API key (required for walk mode with map visualization)
# Get key from: https://console.cloud.google.com/google/maps-apis
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Tag Manager container ID (optional; leave empty to disable analytics)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX